<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>event — HallOfFrame results</title><style>
* { box-sizing: border-box; }
body {
  margin: 0;
  background: #0d1114;
  font-family: 'IBM Plex Sans','Helvetica Neue',Arial,sans-serif;
  color: #f2f6f8;
  -webkit-font-smoothing: antialiased;
}
.wrap { margin: 0 auto; }
.mono { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; }
.c-text { color: #f2f6f8; }
.c-text2 { color: #c6d3da; }
.c-dim { color: #8fa0ab; }
.c-faint { color: #5f6f79; }
.c-blue { color: #6fb2e8; }
.c-amber { color: #ffb43a; }
.thumb {
  position: relative; width: 268px; height: 168px; flex: none;
  background: #1b262c; border-radius: 2px; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.thumb-empty { flex-direction: column; gap: 10px; }
.thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
.finish-line {
  position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
  background: rgba(255,90,66,.9);
}
.badge {
  position: absolute; top: 8px; left: 8px;
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 11px; font-weight: 600; letter-spacing: .08em;
  color: #ffb43a; background: rgba(30,22,8,.92); border: 1px solid #4a3b12;
  border-radius: 2px; padding: 3px 7px;
}
.noimg-title {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 12px; font-weight: 600; letter-spacing: .1em;
  color: #ffb43a;
}
.noimg-sub { font-size: 12px; color: #5f6f79; }
.meta-cell { display: flex; flex-direction: column; gap: 5px; }
.meta-label { font-size: 12px; letter-spacing: .1em; color: #5f6f79; }
.meta-value { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 15px; color: #c6d3da; }
.card {
  display: flex; gap: 26px; align-items: stretch;
  background: #11161a; border: 1px solid #1c2429;
  border-radius: 4px; padding: 16px;
}
.card-body {
  flex: 1; display: flex; flex-direction: column;
  justify-content: space-between; gap: 16px; padding: 4px 0;
}
.card-top {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;
}
.card-left { display: flex; align-items: baseline; gap: 20px; }
.elapsed {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 44px; font-weight: 500;
  color: #f2f6f8; letter-spacing: -.02em;
}
.bow-group { display: flex; align-items: baseline; gap: 9px; }
.bow-label { font-size: 13px; letter-spacing: .1em; color: #5f6f79; }
.bow { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 30px; font-weight: 600; }
.seq {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 13px; color: #5f6f79; letter-spacing: .06em;
}
.card-meta { display: flex; flex-direction: column; gap: 14px; }
.meta-row { display: flex; gap: 44px; flex-wrap: wrap; }
.note-line {
  display: flex; align-items: center; gap: 10px;
  font-size: 14px; color: #ffb43a;
}
.note-text { color: #8fa0ab; }
.flag-chip {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 12px; font-weight: 600; letter-spacing: .08em;
  color: #ffb43a; border: 1px solid #4a3b12; border-radius: 2px; padding: 2px 7px;
}
.race-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 32px; padding: 34px 0 18px;
  border-bottom: 1px solid #232b31; flex-wrap: wrap;
}
.race-head-left { display: flex; flex-direction: column; gap: 8px; }
.race-label-row { display: flex; align-items: baseline; gap: 14px; }
.race-label {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 15px; font-weight: 600;
  letter-spacing: .1em; color: #6fb2e8;
}
.race-id { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 12px; color: #5f6f79; }
.race-name {
  font-size: 27px; font-weight: 500; color: #f2f6f8; letter-spacing: -.01em;
}
.race-head-right {
  display: flex; flex-direction: column; align-items: flex-end; gap: 2px;
}
.race-grid {
  display: grid; grid-template-columns: auto auto auto; gap: 6px 28px;
  text-align: right;
}
.race-meta-label { font-size: 12px; letter-spacing: .1em; color: #5f6f79; }
.race-meta-value { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 17px; }
.cards { display: flex; flex-direction: column; gap: 14px; padding: 24px 0; }
.warn { margin-top: 14px; font-size: 14px; color: #ffb43a; }
.empty { padding: 22px 0 10px; font-size: 15px; color: #5f6f79; }
.excel-btn {
  display: inline-block; margin-top: 10px;
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 13px; font-weight: 600; color: #6fb2e8;
  border: 1px solid #2c3942; border-radius: 3px; padding: 8px 12px;
  cursor: pointer; background: transparent;
}
.head-row {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 40px; flex-wrap: wrap;
}
.brand-col { display: flex; flex-direction: column; gap: 5px; }
.brand {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 26px; font-weight: 600; letter-spacing: -.01em;
}
.brand-red { color: #ff5a42; }
.tagline { font-size: 15px; color: #8fa0ab; }
.head-right {
  display: flex; flex-direction: column; gap: 6px; text-align: right;
}
.generated { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 14px; color: #c6d3da; }
.counts { font-size: 13px; color: #5f6f79; }
.filter-row {
  display: flex; align-items: center; gap: 16px; margin-top: 30px;
  flex-wrap: wrap;
}
.filter-row input {
  flex: 1; min-width: 260px; background: #0b0f12;
  border: 1px solid #1c2429; border-radius: 3px; padding: 11px 14px;
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 16px; color: #f2f6f8;
}
.chips { display: flex; gap: 8px; }
.chip {
  font-size: 14px; font-family: 'IBM Plex Sans','Helvetica Neue',Arial,sans-serif; color: #5f6f79; background: transparent;
  border: 1px solid #1c2429; border-radius: 4px; padding: 8px 14px;
  cursor: pointer;
}
.chip.on { color: #c6d3da; background: #151a1e; border-color: #2c3942; }
.export-head {
  padding: 40px 48px 32px; border-bottom: 1px solid #1c2429;
  background: #11161a;
}
.main-export { padding: 6px 48px 20px; }
.export-footer {
  padding: 22px 48px 30px; border-top: 1px solid #1c2429;
  background: #11161a; display: flex; justify-content: space-between;
  gap: 24px; flex-wrap: wrap; font-size: 13px; color: #5f6f79;
}
.index-head {
  padding: 34px 40px 26px; border-bottom: 1px solid #1c2429;
  background: #11161a;
}
.index-head-row {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; flex-wrap: wrap;
}
.index-brand-col { display: flex; flex-direction: column; gap: 4px; }
.event {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 14px; font-weight: 600;
  letter-spacing: .08em; color: #6fb2e8;
}
.brand-lg { font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 24px; font-weight: 600; }
.index-sub { font-size: 14px; color: #8fa0ab; }
.index-updated { font-size: 13px; color: #5f6f79; }
.index-note { font-size: 13px; color: #5f6f79; margin-top: 14px; }
.main-index { padding: 10px 40px 24px; }
.index-table { width: 100%; border-collapse: collapse; }
.index-thead {
  text-align: left; font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 12px;
  letter-spacing: .1em; color: #5f6f79;
}
.th { padding: 14px 8px 6px; }
.th-right { padding: 14px 8px 6px; text-align: right; }
.row { border-bottom: 1px solid #232b31; }
.td-label { padding: 14px 8px; font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 14px; color: #6fb2e8; }
.td-cat { padding: 14px 8px; font-size: 15px; color: #f2f6f8; }
.td-gun { padding: 14px 8px; font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 14px; color: #c6d3da; }
.td-n {
  padding: 14px 8px; text-align: right; font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace;
  font-size: 14px; color: #8fa0ab;
}
.td-actions { padding: 14px 8px; text-align: right; white-space: nowrap; }
.row-updated { font-size: 12px; color: #5f6f79; margin-top: 3px; }
.link { color: #6fb2e8; text-decoration: none; }
.link-view { font-size: 14px; margin-right: 14px; }
.excel-inline {
  font-family: 'IBM Plex Mono','SFMono-Regular',Consolas,monospace; font-size: 14px; font-weight: 600; color: #6fb2e8;
  background: transparent; border: none; padding: 0; cursor: pointer;
}
.empty-row { padding: 40px; text-align: center; color: #5f6f79; font-size: 15px; }
.index-footer {
  padding: 18px 40px 26px; border-top: 1px solid #1c2429;
  background: #11161a; font-size: 12px; color: #5f6f79;
}
.racepage-head {
  padding: 16px 48px; border-bottom: 1px solid #1c2429;
  background: #11161a; display: flex; align-items: center;
  justify-content: space-between; gap: 24px; flex-wrap: wrap;
}
.back-link { color: #8fa0ab; text-decoration: none; font-size: 14px; }
.main-race { padding: 0 48px 20px; }
.race-footer {
  padding: 18px 48px 26px; border-top: 1px solid #1c2429;
  background: #11161a; font-size: 12px; color: #5f6f79;
}
.about-link { color: #6fb2e8; text-decoration: none; }
</style></head><body><div class="wrap" style="max-width:960px"><header class="index-head"><div class="index-head-row"><div class="index-brand-col"><div class="event">event</div><div class="brand-lg">HallOf<span class="brand-red">Frame</span></div><div class="index-sub">Finish-line results · races</div><div class="index-updated">Results updated 03:04:05</div></div><div class="counts">2 races</div></div><div class="index-note">Photos are on each race page.</div></header><main class="main-index"><table class="index-table"><thead><tr class="index-thead"><th class="th">RACE</th><th class="th">CATEGORY</th><th class="th">GUN</th><th class="th-right">#</th><th class="th-right"></th></tr></thead><tbody><tr class="row"><td class="td-label">RACE 102 · HEAT 2<div class="row-updated">Updated 03:04:05</div></td><td class="td-cat">Women open, double, heat</td><td class="td-gun">22:23:20</td><td class="td-n">1</td><td class="td-actions"><a href="/race/2" class="link link-view">View</a><button type="button" data-excel="2" class="excel-inline">Copy table</button></td></tr><tr class="row"><td class="td-label">RACE 101 · HEAT 1<div class="row-updated">Updated 03:04:05</div></td><td class="td-cat">Men under 18, single, final</td><td class="td-gun">22:13:20</td><td class="td-n">3</td><td class="td-actions"><a href="/race/1" class="link link-view">View</a><button type="button" data-excel="1" class="excel-inline">Copy table</button></td></tr></tbody></table></main><footer class="index-footer">Copy table copies a race to the clipboard — paste it into a spreadsheet to keep the column layout. · <span class="mono">HallOfFrame v<VERSION> · <BUILD_STAMP></span> · <a href="https://github.com/isaeldiaz/HallOfFrame" class="about-link">github.com/isaeldiaz/HallOfFrame</a></footer></div><script>
(function () {
  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.top = '0';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }
  function flash(btn) {
    var old = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(function () { btn.textContent = old; }, 1500);
  }
  var btns = document.querySelectorAll('[data-excel]');
  for (var i = 0; i < btns.length; i++) {
    btns[i].addEventListener('click', function () {
      var id = this.getAttribute('data-excel');
      var btn = this;
      fetch('/excel/' + id)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (navigator.clipboard && window.ClipboardItem) {
            navigator.clipboard.write([new ClipboardItem({
              'text/html': new Blob([data.html], { type: 'text/html' }),
              'text/plain': new Blob([data.tsv], { type: 'text/plain' })
            })]).then(function () { flash(btn); },
                     function () { fallbackCopy(data.tsv); flash(btn); });
          } else {
            fallbackCopy(data.tsv);
            flash(btn);
          }
        })
        .catch(function () { btn.textContent = 'Copy failed'; });
    });
  }
})();

(function () {
  var box = document.getElementById('q');
  if (!box) { return; }
  var chips = document.querySelectorAll('[data-preset]');
  var preset = 'all';
  function apply() {
    var q = (box.value || '').toLowerCase().trim();
    var races = document.querySelectorAll('[data-race]');
    for (var i = 0; i < races.length; i++) {
      var race = races[i];
      var cards = race.querySelectorAll('[data-search]');
      var shown = 0;
      for (var j = 0; j < cards.length; j++) {
        var card = cards[j];
        var hay = card.getAttribute('data-search').toLowerCase();
        var ok = (!q || hay.indexOf(q) !== -1)
          && (preset !== 'photo' || card.getAttribute('data-photo') === '1')
          && (preset !== 'flag' || card.getAttribute('data-flag') !== '');
        card.style.display = ok ? '' : 'none';
        if (ok) shown++;
      }
      var raceHay = race.getAttribute('data-race').toLowerCase();
      var raceMatch = !q || raceHay.indexOf(q) !== -1;
      race.style.display = (shown > 0 || (raceMatch && !cards.length && preset === 'all'))
        ? '' : 'none';
    }
  }
  box.addEventListener('input', apply);
  for (var k = 0; k < chips.length; k++) {
    chips[k].addEventListener('click', function (e) {
      preset = e.currentTarget.getAttribute('data-preset');
      for (var m = 0; m < chips.length; m++) {
        var on = chips[m] === e.currentTarget;
        chips[m].style.background = on ? '#151a1e' : 'transparent';
        chips[m].style.borderColor = on ? '#2c3942' : '#1c2429';
        chips[m].style.color = on ? '#c6d3da' : '#8fa0ab';
      }
      apply();
    });
  }
})();
</script></body>
</html>
